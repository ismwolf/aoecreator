APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# ── Supabase (A.T8) ────────────────────────────────────────────────
# New-format keys only. Rotate legacy JWT keys via Supabase Dashboard.
SUPABASE_URL=https://ngjlxlkdfgfhiookndpl.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# ── Postgres direct connection (C.2) ───────────────────────────────
# Used by AsyncPostgresSaver. Supabase: Project Settings > Database >
# Connection String > URI. Use the Session pooler (port 5432), NOT the
# Transaction pooler (port 6543) — LangGraph uses BEGIN/SAVEPOINT which
# Transaction mode silently breaks.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── OpenRouter (C.3) ───────────────────────────────────────────────
# OpenRouter API key — used for all LLM calls via langchain-openai.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# ── Redis / Celery (D.6) ───────────────────────────────────────────
# Upstash Redis TLS URL — broker + result backend for crawl_site tasks.
REDIS_URL=rediss://:your-upstash-password@your-host.upstash.io:6380

# ── Modal BGE-M3 (D.4) ─────────────────────────────────────────────
# Get URL after `modal deploy infra/modal/embedding_service.py`.
MODAL_EMBED_URL=https://your-username--aeogen-embed.modal.run
