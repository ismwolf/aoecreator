APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# ── Supabase (A.T8) ────────────────────────────────────────────────
# New-format keys only. Rotate legacy JWT keys via Supabase Dashboard.
SUPABASE_URL=https://ngjlxlkdfgfhiookndpl.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# ── Postgres direct connection (C.2) ───────────────────────────────
# Used by AsyncPostgresSaver. Supabase: Project Settings > Database >
# Connection String > URI. Use the Session pooler (port 5432), NOT the
# Transaction pooler (port 6543) — LangGraph uses BEGIN/SAVEPOINT which
# Transaction mode silently breaks.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
