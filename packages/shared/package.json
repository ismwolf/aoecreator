{
  "name": "@aeogen/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "import": "./dist/schemas/*.js"
    }
  },
  "files": [
    "dist",
    "python",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:json-schema",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:json-schema": "tsx src/scripts/emit-json-schema.ts",
    "codegen:python": "tsx src/scripts/codegen-pydantic.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:drift": "tsx src/scripts/check-drift.ts"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
